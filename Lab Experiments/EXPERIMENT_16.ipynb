      "source": [
        "\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "\n",
        "X = [[0, 0], [0, 1], [1, 0], [1, 1]]\n",
        "y = [0, 1, 1, 1]\n",
        "\n",
        "model = MLPClassifier(hidden_layer_sizes=(4,), max_iter=5000, random_state=1)\n",
        "model.fit(X, y)\n",
        "\n",
        "print(\"Prediction:\", model.predict([[1, 1]])[0])\n"
      ]
    }
  ]
}